{
  "name": "autocut",
  "version": "1.2.0-rc.2",
  "private": true,
  "type": "module",
  "description": "Free, browser-only, instruction-driven video editor. No build step required.",
  "scripts": {
    "test": "node --test tests/editor.test.js tests/story-model.test.js tests/stabilization.test.js",
    "test:browser": "node tests/browser.test.js",
    "serve": "node scripts/serve.js",
    "test:stage1": "node tests/stage1.test.js",
    "test:story": "node tests/story.test.js",
    "test:story-preview": "node tests/story-preview.test.js",
    "test:story-trim": "node tests/story-trim.test.js",
    "test:stabilization": "node tests/stabilization-browser.test.js",
    "test:all": "npm test && npm run test:stage1 && npm run test:browser && npm run test:story && npm run test:story-preview && npm run test:story-trim && npm run test:stabilization && npm run test:quick-pipeline",
    "test:quick-pipeline": "node tests/quick-pipeline.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sparticuz/chromium": "153.0.0",
    "sharp": "0.35.5"
  },
  "license": "GPL-3.0-or-later"
}
